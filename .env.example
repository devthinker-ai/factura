# Example environment (copy to .env — never commit secrets)

# Operator bearer token for API / console (optional; enables auth + rate limit)
FACTURA_TOKEN=
FACTURA_RATE_LIMIT=60
FACTURA_ADDR=:8080
FACTURA_DB=./factura.db

# Offline RS256 license JWT (else settings.license_key; fail-open to Solo caps)
FACTURA_LICENSE_KEY=

# Peppol (optional — online path isolated in pkg/peppol)
# FACTURA_PEPPOL_AP=fake
# FACTURA_PEPPOL_AP_URL=
# FACTURA_PEPPOL_AP_KEY=
# FACTURA_PEPPOL_SELF_ID=
# FACTURA_PEPPOL_CALLBACK_URL=
# FACTURA_PEPPOL_POLL=
